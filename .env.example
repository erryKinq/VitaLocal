# Copy to .env and adjust. Never commit .env.
POSTGRES_PASSWORD=change-me
# Long random token, e.g. `openssl rand -hex 32`. It is the login for the WebUI and the app.
VITALOCAL_API_TOKEN=change-me
# Host interface the API is published on (127.0.0.1 = local only, e.g. behind a reverse proxy on
# the same host; set the LAN/VPN IP to reach it from other devices directly)
VITALOCAL_BIND=127.0.0.1
VITALOCAL_PORT=8000
# Day boundaries (IANA time zone name)
VITALOCAL_TIMEZONE=Europe/Berlin
# A published server image instead of building from ./server
# VITALOCAL_IMAGE=ghcr.io/errykinq/vitalocal:latest
# Days an export's raw bytes stay once a newer export of the same source arrived (0 = keep forever).
# The imported data always stays; only the uploaded files are removed.
VITALOCAL_RAW_RETENTION_DAYS=7
# Open Food Facts lookups (barcode, online search) from the food diary: a contact (e-mail or URL)
# for the User-Agent, as OFF asks of API users; VITALOCAL_OFF_ENABLED=false switches lookups off.
# VITALOCAL_OFF_CONTACT=you@example.org
# Online search only shows products sold in this country (OFF country tag, e.g. germany, france;
# empty = all countries)
# VITALOCAL_OFF_COUNTRY=germany
# Optional AI defaults (any OpenAI-compatible endpoint); usually set in the WebUI instead
# VITALOCAL_AI_BASE_URL=http://ollama:11434/v1
# VITALOCAL_AI_MODEL=qwen3:14b
# VITALOCAL_AI_API_KEY=
# Only for building the Android app yourself: where android/build.sh publishes the APK
# VITALOCAL_PUBLISH_URL=http://<server>:8000
# Only for building the Garmin watch app yourself (watch/build.sh)
# VITALOCAL_WATCH_URL=http://<server>:8000
