#!/usr/bin/env python3
"""vl — VitaLocal API CLI.

Thin, scriptable wrapper over the VitaLocal REST API (server >= 0.2) for
agents and scripts: journaling, check-ins, drinks, habits, and health-data reads.
Python stdlib only.

Server: VITALOCAL_URL env var, else ~/.config/vitalocal/url, else http://localhost:8000.

Token resolution order:
  1. VITALOCAL_API_TOKEN env var
  2. ~/.config/vitalocal/api_token (chmod 600, opt-in cache)
  3. optional Vaultwarden helper (VL_VAULT_HELPER, a vault-access.py) -> item
     "VitaLocal" (each call; slow — avoid in loops; set VL_TOKEN_CACHE=1 to
     write the credential-file cache on first fetch)

Some reverse proxies/WAFs reject the default Python-urllib User-Agent, so
this tool always sends its own UA.

Examples:
  vl health | meta | metrics | today [DAY] | day DAY | insights [DAY]
  vl trends steps,weight FROM TO
  vl samples heart_rate FROM TO [--bucket 15m] [--series]

  vl journal get [DAY]
  vl journal append "text" [DAY]              # versioned read-modify-write, retries 409 once
  vl journal set - [DAY]                      # replace text from stdin ('' clears entry)
  vl journal list FROM TO

  vl journal week get [DAY-IN-WEEK]           # review + computed facts
  vl journal week facts [DAY-IN-WEEK]         # facts only
  vl journal week set - [DAY-IN-WEEK]         # write review text from stdin (versioned)
  vl journal week append "text" [DAY-IN-WEEK]
  vl journal month get|facts|set|append ...   # same for the calendar month

  vl journal reviews FROM TO                  # weekly+monthly reviews, newest first
  vl journal revisions DAY [--scope day|week|month]
  vl journal search "query" [--limit 30]

  vl checkin mood 4 | energy 3 | symptom "Kopfschmerzen" 3 | rpe 8 [--activity ID] | note "text"
  vl checkin list FROM TO [--kind mood] | delete ID | post JSON
  vl drink add 250 [--drink water|tea|coffee|other] [--ts ISO]   # log a drink
  vl drink list [DAY] | list FROM TO | delete ID
  vl food add "Name" --kcal 650 [--protein G --carbs G --fat G --sugar G] --meal NAME|INDEX [--ts ISO]
  vl food day [DAY] | meals | delete ID                            # nutrition (quick entries)
  vl habits [--archived] | habit-metrics
  vl habit log <habit-id-or-name> 1 [DAY] | habit status FROM TO

  vl get /api/v1/any/path[?query]             # raw GET, authenticated
  vl token-status
"""
import argparse
import datetime
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid

URL_FILE = os.path.expanduser("~/.config/vitalocal/url")


def _base_url():
    url = os.environ.get("VITALOCAL_URL")
    if not url and os.path.isfile(URL_FILE):
        url = open(URL_FILE).read().strip()
    return (url or "http://localhost:8000").rstrip("/")


BASE = _base_url()
UA = "vitalocal-vl-cli/1.0"
DEFAULT_SOURCE = "agent"
CRED_FILE = os.path.expanduser("~/.config/vitalocal/api_token")
VAULT_HELPER = os.path.expanduser(os.environ.get(
    "VL_VAULT_HELPER", "~/.local/share/vault-access/vault-access.py"))
_state = {"vault_item": None, "token_source": None}


def _vault_token():
    """Fetch the token via the vaultwarden-access helper (relocks after)."""
    if not os.path.isfile(VAULT_HELPER):
        sys.exit("no API token: set VITALOCAL_API_TOKEN or write it to %s" % CRED_FILE)
    if _state["vault_item"] is None:
        out = subprocess.run(
            ["python3", VAULT_HELPER, "search", "--query", "VitaLocal"],
            capture_output=True, text=True, timeout=180)
        try:
            meta = json.loads(out.stdout)
        except (ValueError, TypeError):
            sys.exit("vault search failed: %s %s" % (
                out.stdout.strip()[:200], out.stderr.strip()[:200]))
        exact = [i for i in meta.get("items", []) if i["name"].lower() == "vitalocal"]
        if len(exact) != 1:
            sys.exit("expected exactly one 'VitaLocal' vault item, got %d" % len(exact))
        _state["vault_item"] = exact[0]["id"]
    out = subprocess.run(
        ["python3", VAULT_HELPER, "legacy", "get", "item", _state["vault_item"]],
        capture_output=True, text=True, timeout=180)
    try:
        item = json.loads(out.stdout)
    except (ValueError, TypeError):
        sys.exit("vault item decode failed (helper relocked the vault)")
    token = (item.get("login") or {}).get("password") or item.get("password")
    if not token:
        sys.exit("vault item has no password field")
    return token.strip()


def get_token():
    tok = os.environ.get("VITALOCAL_API_TOKEN")
    if tok:
        _state["token_source"] = "env"
        return tok.strip()
    if os.path.isfile(CRED_FILE):
        tok = open(CRED_FILE).read().strip()
        if tok:
            _state["token_source"] = "file"
            return tok
    tok = _vault_token()
    _state["token_source"] = "vault"
    if os.environ.get("VL_TOKEN_CACHE") == "1":
        os.makedirs(os.path.dirname(CRED_FILE), mode=0o700, exist_ok=True)
        fd = os.open(CRED_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(tok + "\n")
    return tok


def _hdrs():
    return {"User-Agent": UA,
            "Authorization": "Bearer " + get_token(),
            "Content-Type": "application/json"}


def request(method, path, body=None, raw=False, quiet=False):
    """Perform one API call. Returns (status, parsed_or_text). Prints unless quiet."""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BASE + path, data=data, headers=_hdrs(), method=method)
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            text, status = r.read().decode("utf-8", "replace"), r.status
    except urllib.error.HTTPError as e:
        text, status = e.read().decode("utf-8", "replace"), e.code
    except Exception as e:
        sys.exit("%s %s -> transport error: %s: %s" % (method, path, type(e).__name__, e))
    try:
        parsed = json.loads(text)
    except ValueError:
        parsed = text
    if not quiet:
        if raw:
            print(text)
        elif isinstance(parsed, (dict, list)):
            print(json.dumps(parsed, indent=2, ensure_ascii=False))
        else:
            print(text)
    return status, parsed


def api(method, path, body=None, **kw):
    status, parsed = request(method, path, body, **kw)
    if status >= 400:
        sys.exit(1)
    return parsed


def day_or_today(arg):
    return arg or datetime.date.today().isoformat()


def journal_put(path, text, source=DEFAULT_SOURCE, retries=1):
    """Versioned read-modify-write of a journal/week/month text.

    Always GETs the current version first and PUTs against it; on 409
    (concurrent write) re-reads and rebuilds once, then gives up loudly."""
    for attempt in range(retries + 1):
        cur = api("GET", path, quiet=True)
        version = cur.get("version", 0)
        status, result = request(
            "PUT", path, {"text": text, "version": version, "source": source},
            quiet=True)
        if status == 409 and attempt < retries:
            sys.stderr.write("journal 409 (concurrent write), retrying once...\n")
            continue
        if status >= 400:
            print(json.dumps(result, indent=2, ensure_ascii=False)
                  if isinstance(result, (dict, list)) else result)
            sys.exit(1)
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return result


def journal_scope_path(scope, day):
    day = day_or_today(day)
    if scope == "day":
        return "/api/v1/journal/" + day
    return "/api/v1/journal/%s/%s" % (scope, day)


def journal_append(scope, text, day, source=DEFAULT_SOURCE, prepend=False):
    path = journal_scope_path(scope, day)
    cur = api("GET", path, quiet=True)
    old = (cur.get("text") or "").rstrip()
    if scope == "day" and not day:
        pass
    new = (text.rstrip() + "\n" + old) if prepend else ((old + "\n" + text) if old else text)
    return journal_put(path, new, source=source)


def journal_set(scope, text_arg, day, source=DEFAULT_SOURCE):
    text = sys.stdin.read() if text_arg == "-" else text_arg
    return journal_put(journal_scope_path(scope, day), text, source=source)


def main():
    ap = argparse.ArgumentParser(prog="vl", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("health")
    sub.add_parser("meta")
    sub.add_parser("metrics")
    p = sub.add_parser("today"); p.add_argument("day", nargs="?")
    p = sub.add_parser("day"); p.add_argument("day")
    p = sub.add_parser("insights"); p.add_argument("day", nargs="?")
    p = sub.add_parser("trends"); p.add_argument("metrics_str"); p.add_argument("date_from"); p.add_argument("date_to")
    p = sub.add_parser("samples"); p.add_argument("metric"); p.add_argument("date_from"); p.add_argument("date_to")
    p.add_argument("--bucket"); p.add_argument("--limit", type=int)
    p.add_argument("--series", action="store_true", help="print raw response text")

    # --- journal ---
    j = sub.add_parser("journal"); js = j.add_subparsers(dest="sub", required=True)
    for scope in ("day", "week", "month"):
        name = "day" if scope == "day" else scope
        if scope == "day":
            sp = js
        else:
            sp = js.add_parser(scope).add_subparsers(dest="sub2", required=True)
        p = sp.add_parser("get"); p.add_argument("day", nargs="?")
        p = sp.add_parser("set"); p.add_argument("text", help="'-' reads stdin"); p.add_argument("day", nargs="?")
        p.add_argument("--source", default=DEFAULT_SOURCE)
        p = sp.add_parser("append"); p.add_argument("text"); p.add_argument("day", nargs="?")
        p.add_argument("--source", default=DEFAULT_SOURCE)
        if scope != "day":
            p = sp.add_parser("facts"); p.add_argument("day", nargs="?")
    p = js.add_parser("list"); p.add_argument("date_from"); p.add_argument("date_to")
    p = js.add_parser("reviews"); p.add_argument("date_from"); p.add_argument("date_to")
    p = js.add_parser("revisions"); p.add_argument("day"); p.add_argument("--scope", choices=["day", "week", "month"])
    p = js.add_parser("search"); p.add_argument("query"); p.add_argument("--limit", type=int)

    # --- checkins ---
    c = sub.add_parser("checkin"); cs = c.add_subparsers(dest="sub", required=True)
    p = cs.add_parser("post"); p.add_argument("json", help="full JSON body or '-' for stdin")
    for kind in ("mood", "energy"):
        p = cs.add_parser(kind); p.add_argument("value", type=int)
        p.add_argument("--source", default=DEFAULT_SOURCE); p.add_argument("--ts"); p.add_argument("--note")
    p = cs.add_parser("symptom"); p.add_argument("label"); p.add_argument("value", nargs="?", type=int)
    p.add_argument("--source", default=DEFAULT_SOURCE); p.add_argument("--ts"); p.add_argument("--note")
    p = cs.add_parser("rpe"); p.add_argument("value", type=int)
    p.add_argument("--activity"); p.add_argument("--source", default=DEFAULT_SOURCE); p.add_argument("--ts"); p.add_argument("--note")
    p = cs.add_parser("note"); p.add_argument("text")
    p.add_argument("--source", default=DEFAULT_SOURCE); p.add_argument("--ts")
    p = cs.add_parser("list"); p.add_argument("date_from"); p.add_argument("date_to"); p.add_argument("--kind")
    p = cs.add_parser("delete"); p.add_argument("id")

    # --- drinks ---
    d = sub.add_parser("drink", help="log/list/delete drinks (nutrition, not journal)")
    ds = d.add_subparsers(dest="sub", required=True)
    p = ds.add_parser("add", aliases=[]); p.add_argument("ml", type=int)
    p.add_argument("--drink", default="water", choices=["water", "tea", "coffee", "other"])
    p.add_argument("--ts"); p.add_argument("--source", default=DEFAULT_SOURCE)
    p = ds.add_parser("list"); p.add_argument("a", nargs="?"); p.add_argument("b", nargs="?")
    p = ds.add_parser("delete"); p.add_argument("id")

    # --- food (quick entries: name + nutrients for the whole portion) ---
    fd = sub.add_parser("food", help="log/list/delete food entries (nutrition quick entries)")
    fs = fd.add_subparsers(dest="sub", required=True)
    p = fs.add_parser("add"); p.add_argument("name"); p.add_argument("--kcal", type=float, required=True)
    for n in ("protein", "carbs", "fat", "sugar"):
        p.add_argument("--" + n, type=float)
    p.add_argument("--meal", required=True, help="meal name from 'vl food meals' or its index")
    p.add_argument("--ts", help="ISO time with time zone (default: now)")
    p = fs.add_parser("day"); p.add_argument("day", nargs="?")
    fs.add_parser("meals")
    p = fs.add_parser("delete"); p.add_argument("id")

    # --- habits ---
    h = sub.add_parser("habits"); h.add_argument("--archived", action="store_true")
    sub.add_parser("habit-metrics")
    hl = sub.add_parser("habit", help="habit ops")
    hls = hl.add_subparsers(dest="sub", required=True)
    p = hls.add_parser("log"); p.add_argument("habit"); p.add_argument("value", type=float); p.add_argument("day", nargs="?")
    p = hls.add_parser("status"); p.add_argument("date_from"); p.add_argument("date_to")

    # Training API: explicit JSON bodies preserve client-chosen idempotency keys.
    t = sub.add_parser("training", help="strength training API")
    ts = t.add_subparsers(dest="sub", required=True)
    for name in ("muscles", "exercises", "plans", "next", "stats", "facts", "sessions"):
        p = ts.add_parser(name)
        if name == "sessions":
            p.add_argument("--from", dest="date_from")
            p.add_argument("--to", dest="date_to")
        if name == "stats": p.add_argument("--weeks", type=int)
        if name == "facts":
            p.add_argument("--day")
            p.add_argument("--days", type=int)
    p = ts.add_parser("session"); p.add_argument("id", type=int)
    p = ts.add_parser("exercise-delete"); p.add_argument("id")
    for name in ("exercise-post", "plan-post", "session-post"):
        p = ts.add_parser(name); p.add_argument("json", help="JSON or '-' for stdin; supply stable id/manual_key")
    for name in ("session-put", "exercise-put", "plan-put"):
        p = ts.add_parser(name); p.add_argument("id", type=int if name == "session-put" else str); p.add_argument("json")

    p = sub.add_parser("get"); p.add_argument("path")
    sub.add_parser("token-status")

    a = ap.parse_args()

    if a.cmd == "health":
        req = urllib.request.Request(BASE + "/health", headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=20) as r:
            print(r.status, r.read().decode())
        return
    if a.cmd == "token-status":
        get_token()
        print(json.dumps({"source": _state["token_source"], "base": BASE}))
        return

    if a.cmd == "meta":
        api("GET", "/api/v1/meta")
    elif a.cmd == "metrics":
        api("GET", "/api/v1/metrics")
    elif a.cmd == "today":
        api("GET", "/api/v1/today?day=" + day_or_today(a.day))
    elif a.cmd == "day":
        api("GET", "/api/v1/days/" + a.day)
    elif a.cmd == "insights":
        api("GET", "/api/v1/insights?day=" + day_or_today(a.day))
    elif a.cmd == "trends":
        api("GET", "/api/v1/trends?metrics=%s&from=%s&to=%s"
            % (urllib.parse.quote(a.metrics_str), a.date_from, a.date_to))
    elif a.cmd == "samples":
        q = "/api/v1/samples?metric=%s&from=%s&to=%s" % (a.metric, a.date_from, a.date_to)
        if a.bucket:
            q += "&bucket=" + a.bucket
        if a.limit:
            q += "&limit=%d" % a.limit
        api("GET", q, raw=a.series)
    elif a.cmd == "journal":
        if a.sub == "list":
            api("GET", "/api/v1/journal?from=%s&to=%s" % (a.date_from, a.date_to))
        elif a.sub == "reviews":
            api("GET", "/api/v1/journal/reviews?from=%s&to=%s" % (a.date_from, a.date_to))
        elif a.sub == "revisions":
            q = "/api/v1/journal/revisions?day=" + a.day
            if a.scope:
                q += "&scope=" + a.scope
            api("GET", q)
        elif a.sub == "search":
            q = "/api/v1/journal/search?q=" + urllib.parse.quote(a.query)
            if a.limit:
                q += "&limit=%d" % a.limit
            api("GET", q)
        elif a.sub == "get":
            api("GET", journal_scope_path("day", a.day))
        elif a.sub == "set":
            journal_set("day", a.text, a.day, source=a.source)
        elif a.sub == "append":
            journal_append("day", a.text, a.day, source=a.source)
        else:  # week / month
            scope = a.sub
            if a.sub2 == "get":
                api("GET", journal_scope_path(scope, a.day))
            elif a.sub2 == "facts":
                facts = api("GET", journal_scope_path(scope, a.day), quiet=True)
                print(json.dumps({"start": facts.get("start"), "end": facts.get("end"),
                                  "facts": facts.get("facts"),
                                  "facts_saved": facts.get("facts_saved"),
                                  "version": facts.get("version"),
                                  "has_text": bool(facts.get("text"))},
                                 indent=2, ensure_ascii=False))
            elif a.sub2 == "set":
                journal_set(scope, a.text, a.day, source=a.source)
            elif a.sub2 == "append":
                journal_append(scope, a.text, a.day, source=a.source)
    elif a.cmd == "checkin":
        if a.sub == "list":
            q = "/api/v1/checkins?from=%sT00:00:00%%2B02:00&to=%sT23:59:59%%2B02:00" % (
                a.date_from, a.date_to)
            if a.kind:
                q += "&kind=" + a.kind
            api("GET", q)
        elif a.sub == "delete":
            api("DELETE", "/api/v1/checkins/" + a.id)
        elif a.sub == "post":
            api("POST", "/api/v1/checkins",
                json.loads(sys.stdin.read() if a.json == "-" else a.json))
        else:
            body = {"id": str(uuid.uuid4()), "kind": a.sub, "source": a.source}
            if a.sub in ("mood", "energy", "rpe"):
                body["value"] = a.value
            if a.sub == "symptom":
                body["label"] = a.label
                if a.value is not None:
                    body["value"] = a.value
            if a.sub == "note":
                body["note"] = a.text
            for k in ("ts", "note", "activity"):
                v = getattr(a, k, None)
                if v:
                    body[k if k != "activity" else "activity_id"] = v
            api("POST", "/api/v1/checkins", body)
    elif a.cmd == "drink":
        if a.sub == "add":
            body = {"id": str(uuid.uuid4()), "drink": a.drink, "ml": a.ml,
                    "source": a.source}
            if a.ts:
                body["ts"] = a.ts
            api("POST", "/api/v1/drinks", body)
        elif a.sub == "list":
            if a.a and not a.b:
                api("GET", "/api/v1/drinks?day=" + a.a)
            elif a.a and a.b:
                api("GET", "/api/v1/drinks?from=%sT00:00:00%%2B02:00&to=%sT23:59:59%%2B02:00"
                    % (a.a, a.b))
            else:
                api("GET", "/api/v1/drinks?day=" + day_or_today(None))
        elif a.sub == "delete":
            api("DELETE", "/api/v1/drinks/" + a.id)
    elif a.cmd == "food":
        if a.sub == "add":
            meals = api("GET", "/api/v1/settings/meals", quiet=True)
            if a.meal.isdigit() and int(a.meal) < len(meals):
                meal = int(a.meal)
            else:
                names = [m.lower() for m in meals]
                if a.meal.lower() not in names:
                    sys.exit("unknown meal %r, choose from: %s" % (a.meal, ", ".join(meals)))
                meal = names.index(a.meal.lower())
            keys = {"kcal": "calories", "protein": "proteins", "carbs": "carbohydrates", "fat": "fat", "sugar": "sugars"}
            nutrients = {k: getattr(a, arg) for arg, k in keys.items() if getattr(a, arg) is not None}
            body = {"id": str(uuid.uuid4()), "name": a.name, "nutrients": nutrients, "meal_index": meal,
                    "logged_at": a.ts or datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
                    "entered_via": "agent"}
            api("POST", "/api/v1/nutrition/entries", body)
        elif a.sub == "day":
            api("GET", "/api/v1/nutrition/" + day_or_today(a.day))
        elif a.sub == "meals":
            api("GET", "/api/v1/settings/meals")
        elif a.sub == "delete":
            api("DELETE", "/api/v1/nutrition/entries/" + a.id)
    elif a.cmd == "habits":
        api("GET", "/api/v1/habits" + ("?include_archived=true" if a.archived else ""))
    elif a.cmd == "habit-metrics":
        api("GET", "/api/v1/habits/metrics")
    elif a.cmd == "habit":
        if a.sub == "status":
            api("GET", "/api/v1/habits/status?from=%s&to=%s" % (a.date_from, a.date_to))
        elif a.sub == "log":
            hid = a.habit
            if len(hid) != 36 or hid.count("-") != 4:  # not a UUID -> resolve by name
                habits = api("GET", "/api/v1/habits?include_archived=true", quiet=True)
                hl_list = habits if isinstance(habits, list) else habits.get("habits", [])
                matches = [x for x in hl_list if x.get("name", "").lower() == hid.lower()]
                if len(matches) != 1:
                    sys.exit("habit '%s': %d matches" % (hid, len(matches)))
                hid = matches[0]["id"]
            api("PUT", "/api/v1/habits/%s/log/%s" % (hid, day_or_today(a.day)),
                {"value": a.value})
    elif a.cmd == "training":
        root = "/api/v1/training/"
        if a.sub in ("exercise-post", "plan-post", "session-post", "session-put", "exercise-put", "plan-put"):
            body = json.loads(sys.stdin.read() if a.json == "-" else a.json)
            endpoint = {"exercise": "exercises", "plan": "plans", "session": "sessions"}[a.sub.split("-")[0]]
            if a.sub == "session-post" and not body.get("manual_key"):
                sys.exit("session-post requires a stable manual_key UUID")
            if a.sub in ("exercise-post", "plan-post") and not body.get("id"):
                sys.exit("creation requires a stable id UUID")
            if a.sub.endswith("-put"):
                endpoint += "/" + str(a.id)
            api("PUT" if a.sub.endswith("-put") else "POST", root + endpoint, body)
        elif a.sub == "exercise-delete":
            api("DELETE", root + "exercises/" + a.id)
        elif a.sub == "session":
            api("GET", root + "sessions/" + str(a.id))
        else:
            params = {}
            for attr, key in (("date_from", "from"), ("date_to", "to"),
                              ("weeks", "weeks"), ("day", "day"), ("days", "days")):
                value = getattr(a, attr, None)
                if value is not None: params[key] = value
            api("GET", root + a.sub + ("?" + urllib.parse.urlencode(params) if params else ""))
    elif a.cmd == "get":
        api("GET", a.path if a.path.startswith("/") else "/" + a.path)


if __name__ == "__main__":
    main()