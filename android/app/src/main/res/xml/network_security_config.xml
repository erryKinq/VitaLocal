<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed technically; the app itself only accepts it for local/WireGuard addresses
     (Settings.isLocalHost). User CAs are trusted so a private CA on the NAS reverse proxy works. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
